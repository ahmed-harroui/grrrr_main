# Copy to .env.local and fill in.
ANTHROPIC_API_KEY=
# Sanity: project id from sanity.io/manage, and an API token with the Editor role
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_WRITE_TOKEN=
# true = automatic guides are published directly, false = saved as drafts to review in /studio
AUTO_PUBLISH=false
# Supabase (community threads, sign-in, upvotes): Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (server only): shares guides on /threads and feeds the GRRR Care assistant's knowledge
SUPABASE_SECRET_KEY=
# Sanity webhook signing secret (sanity.io/manage → API → Webhooks)
SANITY_WEBHOOK_SECRET=
# Basic-auth login for /studio in production
STUDIO_USER=
STUDIO_PASSWORD=
